rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Owner's account PLUS the `adminMfa` claim that only the OTP verification
    // endpoint can mint. A stolen password alone yields an ID token with no
    // `adminMfa` claim, so those writes are rejected here regardless of what
    // the UI does.
    function isVerifiedAdmin() {
      return isAuthenticated()
        && request.auth.token.email == 'kpugazhmani21@gmail.com'
        && 'adminMfa' in request.auth.token
        && request.auth.token.adminMfa == true;
    }

    // Blog posts - public read, MFA-verified admin only writes
    match /blogPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if isVerifiedAdmin();
    }

    // Learning topics - public read, MFA-verified admin only writes
    match /learningTopics/{topicId} {
      allow read: if true;
      allow create, update, delete: if isVerifiedAdmin();
    }

    // One-time codes live here. Never readable or writable by any client;
    // only the Admin SDK (server) touches them.
    match /otps/{uid} {
      allow read, write: if false;
    }

    // Per-account send counters backing the code rate limit.
    match /otpRate/{uid} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
