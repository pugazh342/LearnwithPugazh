rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Learning PDFs - public read, authenticated write
    match /learning-pdfs/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }
  }
}
